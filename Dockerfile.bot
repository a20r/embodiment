# The bot container: plain Debian + Python, nothing else.
# Built once with network; always run with --network=none (airgapped).
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 procps \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /bot
CMD ["sleep", "infinity"]
